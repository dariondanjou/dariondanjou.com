# Treat binary asset types as binary so git doesn't try to normalize
# line endings inside them. (Without this, .pdf / .png files round-trip
# through git's CRLF filter on Windows and can be corrupted on commit.)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.mov binary
*.m4a binary
*.mp3 binary
*.zip binary
